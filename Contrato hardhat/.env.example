# =============================================================
#  CONTAS — cada role usa sua própria carteira
#  Crie 4 contas no MetaMask, exporte as chaves (sem 0x)
#  Apenas o DEPLOYER precisa de ETH; o script repassa para as demais
# =============================================================

DEPLOYER_PRIVATE_KEY=chave_privada_do_admin_aqui

# Preenchido após rodar deploy.js — usado pelo seed.js
CONTRACT_ADDRESS=
MONTADORA_PRIVATE_KEY=chave_privada_da_montadora_aqui
DETRAN_PRIVATE_KEY=chave_privada_do_detran_aqui
OFICINA_PRIVATE_KEY=chave_privada_da_oficina_aqui

# =============================================================
#  RPC URLs
#  Sepolia: crie um app em https://www.alchemy.com → Ethereum → Sepolia
# =============================================================

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_KEY
POLYGON_RPC_URL=https://polygon-rpc.com

# =============================================================
#  API Keys para verificação de contrato no explorer (opcional)
#  Etherscan: https://etherscan.io/myapikey
#  Polygonscan: https://polygonscan.com/myapikey
# =============================================================

ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
